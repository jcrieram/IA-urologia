# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# Opcionales: si los omites se usan estos mismos valores por defecto.
# Para más capacidad (y más coste) cambia el modelo a claude-opus-5.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=1024

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: meta | twilio
WHATSAPP_PROVIDER=twilio

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Console de Twilio: Account SID + Auth Token
# Messaging > Try it Out > Send a WhatsApp message (sandbox gratis)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Comprueba que el webhook viene de Twilio. Déjalo en true: sin esto,
# cualquiera que descubra tu URL puede escribirle al agente.
TWILIO_VALIDAR_FIRMA=true

# La URL pública exacta que pegaste en Twilio ("WHEN A MESSAGE COMES IN"),
# SIN /webhook al final y SIN barra al final. En desarrollo es tu URL de
# ngrok (cambia cada vez que reinicias ngrok); en producción, la de Railway.
# Ejemplo: https://unpack-return-zoning.ngrok-free.dev
PUBLIC_BASE_URL=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
